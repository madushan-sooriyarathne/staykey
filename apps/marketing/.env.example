# The API, called from this site's server only.
STAYKEY_API_URL=http://localhost:8080
# The API's STAYKEY_FORWARD_SECRET, so sign-in code limits count the visitor rather than this
# site. Leave empty in development.
STAYKEY_FORWARD_SECRET=
# Opens invite links in the app. The Apple Developer team id, and the SHA-256 fingerprints of the
# Android app's signing certificates (comma-separated, from Play Console or `eas credentials`).
STAYKEY_APPLE_TEAM_ID=
STAYKEY_ANDROID_CERT_SHA256=
