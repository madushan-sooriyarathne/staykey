# development | production
APP_ENV=development
PORT=8080

# Matches docker-compose.yml. Required when APP_ENV=production.
DATABASE_URL=postgres://staykey:staykey@localhost:5432/staykey?sslmode=disable

# Booking pages are served at <scheme>://<slug>.<domain>
# Production: staykey.direct with https
STAYKEY_BOOKING_DOMAIN=localhost:3001
STAYKEY_BOOKING_SCHEME=http

# Signs access tokens and keys sign-in code hashes. Required in production, at least 32 bytes:
# openssl rand -base64 48
STAYKEY_AUTH_SECRET=

# How sign-in codes reach Sri Lankan numbers. "log" writes them to the API log (and development
# builds of the app show them on screen); "ozone" texts them through oZone Sender. Numbers from
# other countries are refused for now. Required in production.
STAYKEY_SMS_PROVIDER=log
# oZone Sender credentials, from its documentation page. The sender ID is case sensitive; use
# "oZone Demo" for testing.
STAYKEY_OZONE_USER_ID=
STAYKEY_OZONE_API_KEY=
STAYKEY_OZONE_SENDER_ID=

# Team alerts. Push goes through Expo; the access token is only needed when the Expo project
# requires authorized pushes.
STAYKEY_EXPO_ACCESS_TOKEN=
# "log" writes WhatsApp alerts to the API log until a WhatsApp Business number is registered;
# "cloud" sends an approved template through the WhatsApp Cloud API. The template's body takes
# two parameters: the alert's title and its detail line.
STAYKEY_WHATSAPP_PROVIDER=log
STAYKEY_WHATSAPP_TOKEN=
STAYKEY_WHATSAPP_PHONE_NUMBER_ID=
STAYKEY_WHATSAPP_TEMPLATE=

# Where invite links point, followed by the token. The marketing site's /join page opens the app.
STAYKEY_INVITE_URL=https://staykey.direct/join

# Lets calendar links reach localhost and private addresses, to import a feed served from your
# laptop (python3 -m http.server). On by default in development; refused in production.
STAYKEY_ICAL_ALLOW_PRIVATE=

# Header a trusted proxy puts the client address in, for rate limits. Fly.io: Fly-Client-IP.
STAYKEY_CLIENT_IP_HEADER=

# Lets the booking page and the marketing site, which call the API from their servers, pass on
# the visitor's address for rate limits. The same value goes in their STAYKEY_FORWARD_SECRET.
# At least 32 bytes: openssl rand -base64 32
STAYKEY_FORWARD_SECRET=

# Billing. Each provider is optional; routes that need a missing one answer 503.
# RevenueCat: a v1 secret key reads App Store and Google Play plans. The webhook auth is the
# Authorization value set on the RevenueCat webhook, sent back as is (for example "Bearer ...").
# The external key is the External Source app's secret key; set it to record web purchases in
# RevenueCat too (External Purchases API, private beta).
STAYKEY_REVENUECAT_SECRET_KEY=
STAYKEY_REVENUECAT_WEBHOOK_AUTH=
STAYKEY_REVENUECAT_EXTERNAL_KEY=
# Payments.lk takes web payments in LKR. sk_test_... in the sandbox; production needs sk_live_...
# The webhook secret (whsec_...) is the signing secret of the endpoint pointing at
# <api>/webhooks/payments-lk. The API URL is only for pointing at a staging API.
STAYKEY_PAYMENTSLK_SECRET_KEY=
STAYKEY_PAYMENTSLK_WEBHOOK_SECRET=
STAYKEY_PAYMENTSLK_API_URL=
# The marketing site's billing page. Payments.lk returns owners here, and to /done after paying.
# Defaults: http://localhost:3000/billing in development, https://staykey.direct/billing in production.
STAYKEY_BILLING_URL=

# Email: "log" records that an email was skipped, with the address masked (the default, also in
# production until SES is set up; in development it also logs each email's link). "ses" sends
# through Amazon SES v2 with the keys of an IAM user allowed ses:SendEmail. STAYKEY_EMAIL_FROM is
# an address on the verified domain. The configuration set publishes bounces and complaints to
# the SNS topic subscribed to <api>/webhooks/ses. The webhook only accepts that topic
# (STAYKEY_SES_SNS_TOPIC_ARN, in STAYKEY_SES_REGION) and answers 503 without it.
STAYKEY_EMAIL_PROVIDER=log
STAYKEY_EMAIL_FROM=
STAYKEY_SES_REGION=
STAYKEY_SES_ACCESS_KEY_ID=
STAYKEY_SES_SECRET_ACCESS_KEY=
STAYKEY_SES_CONFIGURATION_SET=
STAYKEY_SES_SNS_TOPIC_ARN=
# The marketing site's email confirmation page. Defaults: http://localhost:3000/verify-email in
# development, https://staykey.direct/verify-email in production.
STAYKEY_VERIFY_EMAIL_URL=

# Encrypts bank account numbers. Required in production: openssl rand -base64 32
STAYKEY_DATA_KEY=

# Photos and logos: "local" keeps them in STAYKEY_MEDIA_DIR and serves them from the API
# (development); "r2" uses Cloudflare R2 (production default).
STAYKEY_STORAGE=local
STAYKEY_MEDIA_DIR=.media
STAYKEY_R2_ENDPOINT=
STAYKEY_R2_BUCKET=
STAYKEY_R2_ACCESS_KEY_ID=
STAYKEY_R2_SECRET_ACCESS_KEY=
# Public address of the bucket, for example https://media.staykey.direct
STAYKEY_MEDIA_URL=

# The API's own address for links to locally stored files. Empty uses the address each request
# came in on, so a phone on your network gets working links.
STAYKEY_PUBLIC_URL=
