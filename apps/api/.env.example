# development | production
APP_ENV=development
PORT=8080

# Matches docker-compose.yml. Required when APP_ENV=production.
DATABASE_URL=postgres://staykey:staykey@localhost:5432/staykey?sslmode=disable

# Booking pages are served at <scheme>://<slug>.<domain>
# Production: staykey.direct with https
STAYKEY_BOOKING_DOMAIN=localhost:3001
STAYKEY_BOOKING_SCHEME=http
