# development | production
APP_ENV=development
PORT=8080

# Matches docker-compose.yml. Required when APP_ENV=production.
DATABASE_URL=postgres://staykey:staykey@localhost:5432/staykey?sslmode=disable

# Booking pages are served at <scheme>://<slug>.<domain>
# Production: staykey.direct with https
STAYKEY_BOOKING_DOMAIN=localhost:3001
STAYKEY_BOOKING_SCHEME=http

# Signs access tokens and keys sign-in code hashes. Required in production, at least 32 bytes:
# openssl rand -base64 48
STAYKEY_AUTH_SECRET=

# How sign-in codes are sent. "log" writes them to the API log (and development builds of the
# app show them on screen). Required in production.
STAYKEY_SMS_PROVIDER=log

# Header a trusted proxy puts the client address in, for rate limits. Fly.io: Fly-Client-IP.
STAYKEY_CLIENT_IP_HEADER=

# Encrypts bank account numbers. Required in production: openssl rand -base64 32
STAYKEY_DATA_KEY=

# Photos and logos: "local" keeps them in STAYKEY_MEDIA_DIR and serves them from the API
# (development); "r2" uses Cloudflare R2 (production default).
STAYKEY_STORAGE=local
STAYKEY_MEDIA_DIR=.media
STAYKEY_R2_ENDPOINT=
STAYKEY_R2_BUCKET=
STAYKEY_R2_ACCESS_KEY_ID=
STAYKEY_R2_SECRET_ACCESS_KEY=
# Public address of the bucket, for example https://media.staykey.direct
STAYKEY_MEDIA_URL=

# The API's own address for links to locally stored files. Empty uses the address each request
# came in on, so a phone on your network gets working links.
STAYKEY_PUBLIC_URL=
