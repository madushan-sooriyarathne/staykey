# development | production
APP_ENV=development
PORT=8080

# Matches docker-compose.yml. Required when APP_ENV=production.
DATABASE_URL=postgres://staykey:staykey@localhost:5432/staykey?sslmode=disable

# Booking pages are served at <scheme>://<slug>.<domain>
# Production: staykey.direct with https
STAYKEY_BOOKING_DOMAIN=localhost:3001
STAYKEY_BOOKING_SCHEME=http

# Signs access tokens and keys sign-in code hashes. Required in production, at least 32 bytes:
# openssl rand -base64 48
STAYKEY_AUTH_SECRET=

# How sign-in codes reach Sri Lankan numbers. "log" writes them to the API log (and development
# builds of the app show them on screen); "ozone" texts them through oZone Sender. Numbers from
# other countries are refused for now. Required in production.
STAYKEY_SMS_PROVIDER=log
# oZone Sender credentials, from its documentation page. The sender ID is case sensitive; use
# "oZone Demo" for testing.
STAYKEY_OZONE_USER_ID=
STAYKEY_OZONE_API_KEY=
STAYKEY_OZONE_SENDER_ID=

# Team alerts. Push goes through Expo; the access token is only needed when the Expo project
# requires authorized pushes.
STAYKEY_EXPO_ACCESS_TOKEN=
# "log" writes WhatsApp alerts to the API log until a WhatsApp Business number is registered;
# "cloud" sends an approved template through the WhatsApp Cloud API. The template's body takes
# two parameters: the alert's title and its detail line.
STAYKEY_WHATSAPP_PROVIDER=log
STAYKEY_WHATSAPP_TOKEN=
STAYKEY_WHATSAPP_PHONE_NUMBER_ID=
STAYKEY_WHATSAPP_TEMPLATE=

# Where invite links point, followed by the token. The marketing site's /join page opens the app.
STAYKEY_INVITE_URL=https://staykey.direct/join

# Header a trusted proxy puts the client address in, for rate limits. Fly.io: Fly-Client-IP.
STAYKEY_CLIENT_IP_HEADER=

# Encrypts bank account numbers. Required in production: openssl rand -base64 32
STAYKEY_DATA_KEY=

# Photos and logos: "local" keeps them in STAYKEY_MEDIA_DIR and serves them from the API
# (development); "r2" uses Cloudflare R2 (production default).
STAYKEY_STORAGE=local
STAYKEY_MEDIA_DIR=.media
STAYKEY_R2_ENDPOINT=
STAYKEY_R2_BUCKET=
STAYKEY_R2_ACCESS_KEY_ID=
STAYKEY_R2_SECRET_ACCESS_KEY=
# Public address of the bucket, for example https://media.staykey.direct
STAYKEY_MEDIA_URL=

# The API's own address for links to locally stored files. Empty uses the address each request
# came in on, so a phone on your network gets working links.
STAYKEY_PUBLIC_URL=
