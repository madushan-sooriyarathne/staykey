# The API, called from this app's server only.
STAYKEY_API_URL=http://localhost:8080
# The API's STAYKEY_FORWARD_SECRET, so limits count guests rather than this
# app. Leave empty in development.
STAYKEY_FORWARD_SECRET=
# Errors go to Sentry only when STAYKEY_ENVIRONMENT is "production" and the DSN is set, so
# development and staging spend none of the free quota. Both are read at build time.
STAYKEY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
# The deployed commit, which Sentry shows as the release.
STAYKEY_RELEASE=
# Source map upload, at build only. Leave empty outside the production deploy.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Turns on POST /internal/test-error, which throws when X-Ops-Secret matches. At least 24
# characters; leave empty to keep the route switched off.
STAYKEY_OPS_SECRET=
