# StayKey API base URL.
# iOS simulator: http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical device: http://<your computer's LAN IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# RevenueCat public SDK keys (appl_... and goog_...). Without one, purchases say they aren't
# available in this build. Purchases need a development build, not Expo Go.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
