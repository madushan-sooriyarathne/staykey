{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "STAYKEY_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "bin/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["CI", "DATABASE_URL", "STAYKEY_TEST_DATABASE_URL"]
    },
    "generate": {
      "inputs": [
        "$TURBO_ROOT$/packages/api-spec/openapi.yaml",
        "**/oapi-codegen.yaml",
        "sqlc.yaml",
        "internal/db/**/*.sql"
      ],
      "outputs": ["src/schema.ts", "internal/oapi/**", "internal/store/queries/**"]
    },
    "migrate": {
      "cache": false,
      "passThroughEnv": ["APP_ENV", "DATABASE_URL"]
    },
    "seed": {
      "cache": false,
      "passThroughEnv": ["APP_ENV", "DATABASE_URL", "STAYKEY_DATA_KEY"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_ENV",
        "PORT",
        "DATABASE_URL",
        "STAYKEY_AUTH_SECRET",
        "STAYKEY_SMS_PROVIDER",
        "STAYKEY_OZONE_USER_ID",
        "STAYKEY_OZONE_API_KEY",
        "STAYKEY_OZONE_SENDER_ID",
        "STAYKEY_EXPO_ACCESS_TOKEN",
        "STAYKEY_WHATSAPP_PROVIDER",
        "STAYKEY_WHATSAPP_TOKEN",
        "STAYKEY_WHATSAPP_PHONE_NUMBER_ID",
        "STAYKEY_WHATSAPP_TEMPLATE",
        "STAYKEY_INVITE_URL",
        "STAYKEY_CLIENT_IP_HEADER",
        "STAYKEY_ICAL_ALLOW_PRIVATE",
        "STAYKEY_BOOKING_DOMAIN",
        "STAYKEY_BOOKING_SCHEME",
        "STAYKEY_PUBLIC_URL",
        "STAYKEY_DATA_KEY",
        "STAYKEY_STORAGE",
        "STAYKEY_MEDIA_DIR",
        "STAYKEY_MEDIA_URL",
        "STAYKEY_R2_ENDPOINT",
        "STAYKEY_R2_BUCKET",
        "STAYKEY_R2_ACCESS_KEY_ID",
        "STAYKEY_R2_SECRET_ACCESS_KEY",
        "STAYKEY_REVENUECAT_SECRET_KEY",
        "STAYKEY_REVENUECAT_WEBHOOK_AUTH",
        "STAYKEY_REVENUECAT_EXTERNAL_KEY",
        "STAYKEY_PAYMENTSLK_SECRET_KEY",
        "STAYKEY_PAYMENTSLK_WEBHOOK_SECRET",
        "STAYKEY_PAYMENTSLK_API_URL",
        "STAYKEY_BILLING_URL",
        "STAYKEY_FORWARD_SECRET",
        "STAYKEY_API_URL"
      ]
    }
  }
}
